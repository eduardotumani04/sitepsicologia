{
  "name": "site-psicologia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 0.0.0.0",
    "build": "node scripts/next.mjs build",
    "postbuild": "node scripts/prepare-static.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "preview": "serve out",
    "test:e2e": "playwright test",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "social:image": "node scripts/generate-social-image.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "serve": { "compression": "1.8.2" }
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "serve": "^14.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
